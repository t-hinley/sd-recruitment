# Keeps the SD Recruitment app running and starts it after a reboot.
# Copy to /etc/systemd/system/sdrecruitment.service
[Unit]
Description=SD Recruitment website (Django + Gunicorn)
After=network.target

[Service]
User=sdadmin
Group=www-data
WorkingDirectory=/srv/sdrecruitment
RuntimeDirectory=sdrecruitment
ExecStart=/srv/sdrecruitment/.venv/bin/gunicorn config.wsgi:application \
    --workers 2 --timeout 60 --umask 007 \
    --bind unix:/run/sdrecruitment/gunicorn.sock \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
