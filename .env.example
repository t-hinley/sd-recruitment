# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Your domain(s), with and without www
DJANGO_ALLOWED_HOSTS=sd-recruitment.com,www.sd-recruitment.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sd-recruitment.com,https://www.sd-recruitment.com
SITE_URL=https://sd-recruitment.com
# On the VPS behind Nginx (DEPLOY_VPS.md): DJANGO_BEHIND_PROXY=True
DJANGO_BEHIND_PROXY=True
# Testing over plain http only (no SSL yet): DJANGO_SECURE_SSL_REDIRECT=False and DJANGO_SECURE_COOKIES=False

# Contact details shown on the website. Leave any of these empty to hide it.
BUSINESS_PHONE=0497 389 693
BUSINESS_EMAIL=admin@sd-recruitment.com
BUSINESS_ADDRESS=Suite 20, 25 Walters Drive, Osborne Park 6017, WA
BUSINESS_HOURS=Monday to Friday, 9:00 am – 5:00 pm
# Optional: LinkedIn company page (shown in the footer when set)
LINKEDIN_URL=

# Email notifications for new candidates, vacancies and messages (SMTP).
# Leave EMAIL_HOST empty to print emails in the terminal (local testing).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
# For port 465 instead: EMAIL_PORT=465, EMAIL_USE_SSL=True, EMAIL_USE_TLS=False
EMAIL_HOST_USER=
# Google Workspace App Password (https://myaccount.google.com/apppasswords), no spaces
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SD Recruitment Website <noreply@example.com.au>
# Inbox(es) that receive notifications, comma separated. Empty = no emails (everything is still in the admin).
ENQUIRY_NOTIFICATION_EMAILS=

# Airtable: each vacancy and candidate registration is also saved to the SD Recruitment Airtable base.
# Leave AIRTABLE_TOKEN empty to switch it off.
# Token: https://airtable.com/create/tokens  (scope data.records:write, access to the SD Recruitment base only)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appv3PA1WBgRGxeX5
# Table for each form: the table ID (starts with "tbl", it's in the address bar when the table is open)
# or the table's exact name. Today both forms save into the same table, tblZaBP5px3dqWuaD.
# "SD Recruitment | Employer Enquiry Form"  ->  Submit a Vacancy (Employers page)
AIRTABLE_EMPLOYER_TABLE=tblZaBP5px3dqWuaD
# "SD Recruitment | Talent Registration Form"  ->  Register Your Interest (Candidates page)
AIRTABLE_TALENT_TABLE=tblZaBP5px3dqWuaD
# If a form gets its own table, its columns must be named as the Airtable form labels
# (e.g. "Company Name", "Full Name"); see core/airtable.py.

# Email candidates a copy of their registration (True/False)
CANDIDATE_CONFIRMATION_EMAILS=True

# Resumes: maximum upload size in MB (keep Nginx client_max_body_size a little higher)
RESUME_MAX_MB=5

# Admin: sign staff out after this many seconds without activity (default 1800 = 30 minutes)
STAFF_IDLE_SECONDS=1800
